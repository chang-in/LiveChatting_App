pipeline {
    agent any // 빌드를 실행할 노드를 지정합니다. "any"는 어떤 노드에서든 실행 가능함을 의미합니다.

    stages {
        stage('Checkout') { // 체크아웃 단계
            steps {
                git url : "https://github.com/mangji12/DevOpsChatApp.git", branch : "main", credentialsId : "	Iv1.7d02dda54a71491e" 
            }
        }

        stage('Build') { // 빌드 단계
            steps {
                sh 'echo "hello' // Maven을 사용하여 프로젝트를 빌드합니다.
            }
        }

    }

    
}